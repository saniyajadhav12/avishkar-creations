# Copy this file to .env.local and fill in the values.
# All values are public by design (security is enforced by Supabase Auth + Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Cloudflare Worker that triggers a site rebuild when an admin taps "Publish changes"
NEXT_PUBLIC_PUBLISH_URL=https://your-worker.your-subdomain.workers.dev
